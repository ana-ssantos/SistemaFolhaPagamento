package sistemaFolhaDePagamento;

public class ColaboradorProducao extends Colaborador{

	private int quantidadePecas;
	private double valorPorPeca;
	
	public ColaboradorProducao(String registro,
							  String nome,
							  int quantidadePecas,
							  double valorPorPeca) {
		
		super(registro, nome);
		
		this.quantidadePecas = quantidadePecas;
		this.valorPorPeca = valorPorPeca;
	}
	public double calcularProdutividade () {
		return quantidadePecas * valorPorPeca;
	}
	
	@Override
	public double calcularSalario () {
		return salarioBase + calcularProdutividade();
		
	}
	
}
